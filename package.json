{
	"name": "warped-hacker-news",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"build": "vite build",
		"preview": "wrangler dev",
		"test": "vitest run",
		"test:browser": "playwright test",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"sanitize-html": "^2.17.0",
		"@fontsource/barlow-condensed": "^5.3.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"@playwright/test": "^1.58.0",
		"@types/node": "^24.19.2",
		"@types/sanitize-html": "^2.16.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"wrangler": "4.164.0"
	}
}
